TIMESERIES_URL=postgresql://postgres:your_timeseries_password_here@postgres:5432/postgres

# MLflow's S3 artifact store (MinIO on the beta box). MLflow's boto3 client
# reads these straight from the process env — nothing in our code sets them.
# Reason: undocumented until 2026-09-09 outage (bucket rejected all writes
# because the container had none of these set at all).
AWS_ACCESS_KEY_ID=your_minio_access_key_here
AWS_SECRET_ACCESS_KEY=your_minio_secret_key_here
MLFLOW_S3_ENDPOINT_URL=http://your_minio_host:9000
